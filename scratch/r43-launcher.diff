+# the host monitors write threads/cores/gpu tsv's, perf.data and intel_gpu_top.json
+# into the run dir, so they are diagnostic artifacts: a QUIET boot's run dir holds
+# the stdout redirect (the crash channel) and nothing else.  --diag arms them;
+# EF2_MONITORS=1 is the perf round's escape; EF2_NO_MONITOR=1 still wins.
+MON_WANT=0
+if [ "$DIAG" -eq 1 ]; then
+    MON_WANT=1
+fi
+if [ "${EF2_MONITORS:-0}" = "1" ]; then
+    MON_WANT=1
+fi
+if [ "${EF2_NO_MONITOR:-0}" = "1" ]; then
+    MON_WANT=0
+fi
+
