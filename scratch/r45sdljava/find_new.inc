// generated by extract_find.py -- verbatim from app/src/main/cpp/code/fgame/listener.cpp
#define EVENT_HASH_SIZE		4096
static int eventHashHead[ EVENT_HASH_SIZE ];

int EvNew::FindEvent( const char *name )
{
	int eventnum;
	long hash;

	assert( name );
	if ( !name )
	{
		return 0;
	}

	if ( !commandList )
	{
		return 0;
	}

	if ( dirtylist )
	{
		SortEventList();
	}

	numfinds++;
	numcompares++;
	if ( lastevent && !stricmp( name, commandList->ObjectAt( lastevent )->c_str() ) )
	{
		numfirstsearch++;
		return lastevent;
	}

	if ( hashdirty )
	{
		BuildEventHash();
	}

	hash = generateHashValue( name );
	for ( eventnum = eventHashHead[ hash ]; eventnum != 0; eventnum = hashNext[ eventnum ] )
	{
		numcompares++;
		if ( !stricmp( name, commandList->ObjectAt( eventnum )->c_str() ) )
		{
			lastevent = eventnum;
			return eventnum;
		}
	}

	return 0;
}

void EvNew::SortEventList( void )
{
	dirtylist = false;
	
	if ( sortedList && commandList )
	{
		qsort( ( void * )sortedList->AddressOfObjectAt( 1 ),
			( size_t )sortedList->NumObjects(),
			sizeof( int ), compareEvents );
	}
}

int EvNew::compareEvents( const void *arg1, const void *arg2 )
{
	int ev1;
	int ev2;
	
	ev1 = *( int * )arg1;
	ev2 = *( int * )arg2;
	
	return stricmp( commandList->ObjectAt( ev1 )->c_str(), commandList->ObjectAt( ev2 )->c_str() );
}

long EvNew::generateHashValue( const char *name )
{
	long hash;
	char letter;
	int i;

	hash = 0;
	i = 0;
	while ( name[ i ] != '\0' )
	{
		letter = tolower( name[ i ] );
		hash += ( long )( letter ) * ( i + 119 );
		i++;
	}

	hash &= ( EVENT_HASH_SIZE - 1 );
	return hash;
}

void EvNew::ResetEventHash( void )
{
	int i;

	delete[] hashNext;
	hashNext = NULL;

	for ( i = 0; i < EVENT_HASH_SIZE; i++ )
	{
		eventHashHead[ i ] = 0;
	}

	hashdirty = true;
}

void EvNew::BuildEventHash( void )
{
	int num;
	int eventnum;
	int i;

	num = commandList->NumObjects();

	/* the heads survive a rebuild, so they start from empty here: a stale head
	   would hand the chain an eventnum this pass has not reached yet */
	for ( i = 0; i < EVENT_HASH_SIZE; i++ )
	{
		eventHashHead[ i ] = 0;
	}

	hashNext = new int[ num + 1 ];
	for ( i = 0; i <= num; i++ )
	{
		hashNext[ i ] = 0;
	}

	/* walking the list backwards puts each bucket in ascending eventnum order,
	   which is registration order -- the answer a duplicate name would have
	   sorted to first. */
	for ( i = num; i > 0; i-- )
	{
		eventnum = generateHashValue( commandList->ObjectAt( i )->c_str() );
		hashNext[ i ] = eventHashHead[ eventnum ];
		eventHashHead[ eventnum ] = i;
	}

	hashdirty = false;
}
