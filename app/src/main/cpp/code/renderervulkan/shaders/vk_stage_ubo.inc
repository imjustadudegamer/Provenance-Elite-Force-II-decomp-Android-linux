	float  u_ShaderTime;
	mat4 u_MVP;
	mat4 u_ModelMatrix;
	vec3 u_ViewOrigin;
	vec3 u_ViewAxis0;
	vec3 u_EntityOrigin;
	mat3 u_EntityAxis;
	vec4 u_EntityColor;
	vec4 u_BaseColor;
	vec4 u_VertColor;
	float u_IdentityLight;
	float u_IdentityLightByte;
	float u_EntityFade;
	float u_PortalRange;
	vec3 u_SpecOrigin;
	vec3 u_SunDirection;
	float u_SkyAlpha;
	vec4 u_EntityTexCoord;
	int  u_ColorGen;
	int  u_AlphaGen;
	int  u_TCGen0;
	int  u_TCGen1;
	vec3 u_TCGen0Vec0;
	vec3 u_TCGen0Vec1;
	vec3 u_TCGen1Vec0;
	vec3 u_TCGen1Vec1;
	float u_AlphaMin;
	float u_AlphaMax;
	float u_AlphaConst;
	float u_AlphaConstMin;
	vec4 u_WaveRGB;
	vec4 u_WaveAlpha;
	float u_FreqRGB;
	float u_FreqAlpha;
	int  u_NumTexMod0;
