	float u_FogDView;
	vec3 u_FogDensityTVector;
	int  u_Acff;
	int  u_FogMode;
	float u_FogStart;
	float u_FogEnd;
	vec4 u_FogFixColor;
	vec4 u_ClipPlane;
	int  u_ClipPlaneEnable;
	vec3 u_LocalViewOrigin;
	float u_ForceAlpha;
	vec2 u_SkyScroll;
	int  u_SkyAlphaMode;
